[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = [
{%- if agentkit_source == 'git' %}
    "agentkit-hosting[cosmos,redis] @ git+https://github.com/{{ agentkit_repo }}@{{ agentkit_ref }}#subdirectory=packages/agentkit-hosting",
    "agentkit-guardrails @ git+https://github.com/{{ agentkit_repo }}@{{ agentkit_ref }}#subdirectory=packages/agentkit-guardrails",
    "agentkit-telemetry[azure] @ git+https://github.com/{{ agentkit_repo }}@{{ agentkit_ref }}#subdirectory=packages/agentkit-telemetry",
    "agentkit-tools @ git+https://github.com/{{ agentkit_repo }}@{{ agentkit_ref }}#subdirectory=packages/agentkit-tools",
{%- if enable_knowledge %}
    "agentkit-knowledge[blob] @ git+https://github.com/{{ agentkit_repo }}@{{ agentkit_ref }}#subdirectory=packages/agentkit-knowledge",
{%- endif %}
{%- if enable_web_chat or enable_teams %}
    "agentkit-channels{% if enable_teams %}[teams]{% endif %} @ git+https://github.com/{{ agentkit_repo }}@{{ agentkit_ref }}#subdirectory=packages/agentkit-channels",
{%- endif %}
{%- else %}
    "agentkit-hosting[cosmos,redis]>=0.6,<0.7",
    "agentkit-telemetry[azure]>=0.6,<0.7",
    "agentkit-tools>=0.6,<0.7",
{%- if enable_knowledge %}
    "agentkit-knowledge[blob]>=0.6,<0.7",
{%- endif %}
{%- if enable_web_chat or enable_teams %}
    "agentkit-channels{% if enable_teams %}[teams]{% endif %}>=0.6,<0.7",
{%- endif %}
{%- endif %}
]

[project.optional-dependencies]
dev = [
{%- if agentkit_source == 'git' %}
    "agentkit-testing @ git+https://github.com/{{ agentkit_repo }}@{{ agentkit_ref }}#subdirectory=packages/agentkit-testing",
{%- else %}
    "agentkit-testing>=0.6,<0.7",
{%- endif %}
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.hatch.metadata]
allow-direct-references = true

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
filterwarnings = ["ignore::DeprecationWarning"]
markers = ["live: runs against the real model through the gateway (set AGENTKIT_LIVE_EVALS=1)"]
