def test_the_next_run_knows_what_was_done_for_a_customer(settings):
    """Subject memory works for anyone (and for scheduled runs): ids and outcomes, never names."""
    client = ScriptedChatClient(script=[
        tool_call(LOG_EVENT_TOOL, subject="customer:1042", event="follow_up_sent", note="ticket T-77"), reply("Done."),
        tool_call(HISTORY_TOOL, subject="customer:1042"), reply("Already followed up."),
    ])
    with serve(settings, client) as http:
        chat(http, ANA, "follow up with customer 1042")
        chat(http, BEN, "has anyone followed up with customer 1042?")
    history = list(client.tool_results().values())[-1]
    assert "follow_up_sent: ticket T-77" in history


@pytest.fixture
def admin(monkeypatch):
    monkeypatch.setenv("AGENTKIT_MEMORY_ADMINS", "ben@contoso.example")
    return BEN


def test_lessons_wait_for_a_memory_admin(settings, admin):
    client = ScriptedChatClient(script=[tool_call(REMEMBER_LESSON_TOOL, text="Order numbers start with A or B"),
                                        reply("Noted.")])
    with serve(settings, client) as http:
        chat(http, ANA, "learn this: order numbers start with A or B")  # Ana isn't a memory admin
        queue = http.get("/v1/memory/agent/lessons?status=pending", headers=admin).json()["items"]
        assert [lesson["text"] for lesson in queue] == ["Order numbers start with A or B"]
        assert http.get("/v1/memory/agent/lessons", headers=ANA).status_code == 403
        approved = http.post(f"/v1/memory/agent/lessons/{queue[0]['id']}/approve", json={}, headers=admin)
        assert approved.json()["status"] == "active"
