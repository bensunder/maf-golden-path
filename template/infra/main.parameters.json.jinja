{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "serviceName": { "value": "{{ project_slug }}" },
    "team": { "value": "{{ team }}" },
    "agentEnvironment": { "value": "${AGENTKIT_ENVIRONMENT=dev}" },
    "platformResourceGroup": { "value": "${AGENTKIT_PLATFORM_RESOURCE_GROUP}" },
    "containerAppsEnvironmentId": { "value": "${AGENTKIT_CONTAINER_APPS_ENVIRONMENT_ID}" },
    "registryName": { "value": "${AGENTKIT_REGISTRY_NAME}" },
    "contentSafetyName": { "value": "${AGENTKIT_CONTENT_SAFETY_NAME}" },
    "appInsightsName": { "value": "${AGENTKIT_APPINSIGHTS_NAME}" },
    "gatewayEndpoint": { "value": "${AGENTKIT_GATEWAY_ENDPOINT}" },
    "model": { "value": "${AGENTKIT_MODEL}" },
    "cosmosAccountName": { "value": "${AGENTKIT_COSMOS_ACCOUNT_NAME}" },
    "cosmosDatabase": { "value": "${AGENTKIT_COSMOS_DATABASE}" },
    "approverRole": { "value": "${AGENTKIT_APPROVER_ROLE=}" },
    "authClientId": { "value": "${AGENTKIT_AUTH_CLIENT_ID=}" }{% if enable_knowledge %},
    "ingestPrincipalId": { "value": "${AZURE_PRINCIPAL_ID=}" },
    "knowledgeEmbeddingModel": { "value": "${AGENTKIT_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small}" }{% endif %}{% if enable_teams %},
    "teamsApproverGroupId": { "value": "${AGENTKIT_TEAMS_APPROVER_GROUP_ID=}" },
    "teamsApprovalsChannelId": { "value": "${AGENTKIT_TEAMS_APPROVALS_CHANNEL_ID=}" }{% endif %}
  }
}
