# Copy to .env for local runs. Never commit .env.
AGENTKIT_ENVIRONMENT=local
AGENTKIT_SERVICE_NAME={{ project_slug }}
AGENTKIT_TEAM={{ team }}

# Model access through the AI gateway (APIM). Local dev authenticates with `az login`.
AGENTKIT_GATEWAY_ENDPOINT=https://<your-apim>.azure-api.net
AGENTKIT_GATEWAY_STYLE=azure
AGENTKIT_MODEL=gpt-4.1-mini
AGENTKIT_AUTH_MODE=azure_cli
# AGENTKIT_GATEWAY_SUBSCRIPTION_KEY=<team product key, if your gateway uses subscriptions>

# Guardrails: heuristic locally; prompt_shields is required in prod.
AGENTKIT_GUARDRAIL_MODE=heuristic
# AGENTKIT_CONTENT_SAFETY_ENDPOINT=https://<your-content-safety>.cognitiveservices.azure.com

# Telemetry: OTLP (e.g. Aspire dashboard at http://localhost:4317) or App Insights.
# AGENTKIT_OTLP_ENDPOINT=http://localhost:4317
# APPLICATIONINSIGHTS_CONNECTION_STRING=
{%- if framework == 'maf' and memory != 'session' %}

# Long-term memory (docs/memory.md). Uses the session store's backend unless AGENTKIT_MEMORY_STORE is set.
# AGENTKIT_MEMORY lowers it without a code change: {% if memory == 'full' %}user (preferences only) or {% endif %}session (none).
# The salt keys all memory; required in prod, 16+ characters, never change it once live.
# AGENTKIT_MEMORY_SALT=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
# AGENTKIT_MEMORY_RETENTION_DAYS=180
# AGENTKIT_MEMORY_MAX_ITEMS=50
{%- if memory == 'full' %}
# Who reviews the agent's lessons and may read its subject memory and journal (comma-separated user ids).
# AGENTKIT_MEMORY_ADMINS=you@contoso.com
# AGENTKIT_MEMORY_SUBJECT_RETENTION_DAYS=365
# AGENTKIT_MEMORY_JOURNAL_RETENTION_DAYS=90
{%- endif %}
# Local only: who to remember for when a request carries no sign-in (the playground, evals).
AGENTKIT_MEMORY_DEV_USER=dev@localhost
{%- endif %}
