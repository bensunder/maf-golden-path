# Copy to .env for local runs. Never commit .env.
AGENTKIT_ENVIRONMENT=local
AGENTKIT_SERVICE_NAME={{ project_slug }}
AGENTKIT_TEAM={{ team }}

# Model access through the AI gateway (APIM). Local dev authenticates with `az login`.
AGENTKIT_GATEWAY_ENDPOINT=https://<your-apim>.azure-api.net
AGENTKIT_GATEWAY_STYLE=azure
AGENTKIT_MODEL=gpt-4.1-mini
AGENTKIT_AUTH_MODE=azure_cli
# AGENTKIT_GATEWAY_SUBSCRIPTION_KEY=<team product key, if your gateway uses subscriptions>

# Guardrails: heuristic locally; prompt_shields is required in prod.
AGENTKIT_GUARDRAIL_MODE=heuristic
# AGENTKIT_CONTENT_SAFETY_ENDPOINT=https://<your-content-safety>.cognitiveservices.azure.com

# Telemetry: OTLP (e.g. Aspire dashboard at http://localhost:4317) or App Insights.
# AGENTKIT_OTLP_ENDPOINT=http://localhost:4317
# APPLICATIONINSIGHTS_CONNECTION_STRING=
