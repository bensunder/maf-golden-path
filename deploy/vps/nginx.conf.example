# nginx instead of Caddy: /etc/nginx/sites-available/agentkit, then
#   ln -s /etc/nginx/sites-available/agentkit /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
#   certbot --nginx -d agent.example.com --redirect
server {
    listen 80;
    server_name agent.example.com;
    location / {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffer_size 16k;      # Entra sign-in cookies are large
        proxy_buffers 8 16k;
        proxy_buffering off;        # chat replies stream
        proxy_read_timeout 300s;
    }
}
