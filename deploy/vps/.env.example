# Copy to .env and fill in. Never commit .env.

# Where people open the agent (Caddy serves TLS for it and forwards to 127.0.0.1:4180)
AGENT_HOST=agent.example.com
PROXY_PORT=4180

# --- the model ---------------------------------------------------------------------------------
# Azure OpenAI with a key:   MODEL_STYLE=azure   MODEL_ENDPOINT=https://<resource>.openai.azure.com   MODEL_NAME=<deployment>
# OpenAI:                    MODEL_STYLE=openai  MODEL_ENDPOINT=https://api.openai.com/v1           MODEL_NAME=gpt-4.1-mini
# LiteLLM / other proxy:     MODEL_STYLE=openai  MODEL_ENDPOINT=http://litellm:4000/v1               MODEL_NAME=<model>
MODEL_STYLE=azure
MODEL_ENDPOINT=https://your-resource.openai.azure.com
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=
# Azure only: the API version (GPT-5 models need 2024-12-01-preview or later)
MODEL_API_VERSION=2025-04-01-preview

# --- sign-in (Entra app registration, docs/vps.md) ----------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=
# optional: only these email domains may sign in, e.g. whyaidata.com
ALLOWED_EMAIL_DOMAINS=*

# --- optional -----------------------------------------------------------------------------------
# Prompt Shields instead of the heuristic injection check (an Azure AI Content Safety resource + key)
GUARDRAIL_MODE=heuristic
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
# Traces and metrics to Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Traces to LangSmith too (a LangSmith API key; the project defaults to each agent's name).
# EU: LANGSMITH_OTEL_ENDPOINT=https://eu.api.smith.langchain.com/otel
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
